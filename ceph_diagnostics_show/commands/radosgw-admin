#!/bin/sh

description() {
    echo "print radosgw-admin command output"
}

help() {
    description
    echo ""
    echo "usage: radosgw-admin [--zone <zone>] [--realm <realm>] <command>"
    echo ""
    echo "Without --zone/--realm, the default realm/zone view is shown."
    echo "Use 'cds rgw zones' to list the collected zones."
    echo ""
    echo "supported commands:"
    echo ""
    echo "  bucket limit check [user_id [bucket]]"
    echo "  bucket stats [bucket]"
    echo "  metadata list bucket.instance"
    echo "  period get                       (default realm, or --realm)"
    echo "  sync status"
    echo ""
    echo "  realm list"
    echo "  zonegroup list"
    echo "  zone list"
    echo "  rgw root ls                      (objects in the realm root pool)"
    echo ""
    echo "per-zone only (require --zone):"
    echo ""
    echo "  metadata list bucket"
    echo "  metadata list user"
    echo "  zone get"
    echo "  zonegroup get"
    echo "  reshard list"
    echo "  reshard stale-instances list"
    echo "  lc list"
}

# same sanitizing as rgw_name() in ceph_diagnostics_collect.sh
rgw_name() {
    echo "$1" | tr -c 'A-Za-z0-9._\n-' '_'
}

bucket_limit_check_filter() {
    local user_id="$1"
    local bucket="$2"

    if [ -n "$bucket" ]; then
	jq ".[] | select(.user_id == \"${user_id}\") | .buckets[] | select(.bucket == \"${bucket}\")"
    elif [ -n "$user_id" ]; then
	jq ".[] | select(.user_id == \"${user_id}\")"
    else
	jq ".[]"
    fi
}

bucket_stats_filter() {
    local bucket="$1"

    if [ -n "$bucket" ]; then
	jq ".[] | select(.bucket == \"${bucket}\")"
    else
	jq ".[]"
    fi
}

zone=
realm=
while true; do
    case "$1" in
        -z|--zone)
            zone="$2"
            shift 2
            ;;
        -r|--realm)
            realm="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

cmd="$@"
file=
filter=cat
prefix="${CEPH_DIAGNOSTICS_COLLECT_DIR}/radosgw_admin_info"
zprefix="${prefix}"
if [ -n "${zone}" ]; then
    zprefix="${prefix}-zone-$(rgw_name "${zone}")"
fi

zone_only() {
    if [ -z "${zone}" ]; then
        echo "${cmd}: --zone <zone> is required (see 'cds rgw zones')" >&2
        exit 1
    fi
}

case "$cmd" in
    description)
        description
        exit 0
        ;;
    help|"help "*|-h|"--help")
        help
        exit 0
        ;;
    "bucket limit check"|"bucket limit check "*)
	file="${zprefix}-bucket_limit_check"
	filter="bucket_limit_check_filter ${cmd#bucket limit check}"
        ;;
    "bucket stats"|"bucket stats "*)
	file="${zprefix}-bucket_stats"
	filter="bucket_stats_filter ${cmd#bucket stats}"
        ;;
    "metadata list bucket.instance")
	file="${zprefix}-metadata_list_bucket.instance"
        ;;
    "period get")
	if [ -n "${realm}" ]; then
	    file="${prefix}-realm-$(rgw_name "${realm}")-period_get"
	else
	    file="${prefix}-period_get"
	fi
        ;;
    "realm list"|"zonegroup list"|"zone list")
	file="${prefix}-$(echo "${cmd}" | tr ' ' '_')"
        ;;
    "rgw root ls")
	file="${prefix}-rgw_root_ls"
        ;;
    "reshard stale-instances list")
	zone_only
	file="${zprefix}-reshard_stale-instances_list"
        ;;
    "metadata list bucket"|"metadata list user"|"zone get"|"zonegroup get"|"reshard list"|"lc list")
	zone_only
	file="${zprefix}-$(echo "${cmd}" | tr ' ' '_')"
        ;;
    "sync status")
	file="${zprefix}-sync_status"
        ;;
    *)
	echo "invalid or unsupported radosgw-admin command: $cmd" >&2
        exit 1
        ;;
esac

if ! [ -e "${file}" ]; then
    echo "${cmd} is not available: cannot find ${file}" >&2
    exit 1
fi

cat "${file}" | ${filter}
